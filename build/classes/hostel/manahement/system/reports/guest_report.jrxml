<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="guest_report"
    pageWidth="842" pageHeight="595" orientation="Landscape"
    columnWidth="782" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">

    <!-- 1. QUERY -->
    <queryString><![CDATA[
        SELECT
            g.guest_id, g.full_name, g.nic, g.phone, g.email, g.address,
            b.booking_id, b.check_in_date, b.check_out_date,
            DATEDIFF(b.check_out_date, b.check_in_date) AS nights,
            b.status AS booking_status,
            r.room_number, r.room_type, r.price_per_night,
            COALESCE(p.amount_paid, 0)            AS amount_paid,
            COALESCE(p.payment_method, 'Pending') AS payment_method
        FROM guests g
        LEFT JOIN bookings b ON g.guest_id   = b.guest_id
        LEFT JOIN rooms    r ON b.room_id    = r.room_id
        LEFT JOIN payments p ON b.booking_id = p.booking_id
        ORDER BY g.full_name, b.check_in_date DESC
    ]]></queryString>

    <!-- 2. FIELDS -->
    <field name="guest_id"        class="java.lang.Integer"/>
    <field name="full_name"       class="java.lang.String"/>
    <field name="nic"             class="java.lang.String"/>
    <field name="phone"           class="java.lang.String"/>
    <field name="email"           class="java.lang.String"/>
    <field name="address"         class="java.lang.String"/>
    <field name="booking_id"      class="java.lang.Integer"/>
    <field name="check_in_date"   class="java.sql.Date"/>
    <field name="check_out_date"  class="java.sql.Date"/>
    <field name="nights"          class="java.lang.Long"/>
    <field name="booking_status"  class="java.lang.String"/>
    <field name="room_number"     class="java.lang.String"/>
    <field name="room_type"       class="java.lang.String"/>
    <field name="price_per_night" class="java.lang.Double"/>
    <field name="amount_paid"     class="java.lang.Double"/>
    <field name="payment_method"  class="java.lang.String"/>

    <!-- 3. VARIABLES -->
    <variable name="GRAND_TOTAL_PAID" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{amount_paid} == null ? 0.0 : $F{amount_paid}]]></variableExpression>
        <initialValueExpression><![CDATA[0.0]]></initialValueExpression>
    </variable>
    <variable name="GUEST_TOTAL" class="java.lang.Double" calculation="Sum"
              resetType="Group" resetGroup="GuestGroup">
        <variableExpression><![CDATA[$F{amount_paid} == null ? 0.0 : $F{amount_paid}]]></variableExpression>
        <initialValueExpression><![CDATA[0.0]]></initialValueExpression>
    </variable>

    <!-- 4. GROUP (must come before title/bands) -->
    <group name="GuestGroup">
        <groupExpression><![CDATA[$F{guest_id}]]></groupExpression>

        <!-- Guest header band -->
        <groupHeader>
            <band height="36">
                <rectangle>
                    <reportElement x="0" y="0" width="782" height="36" backcolor="#1A5276"/>
                    <graphicElement><pen lineWidth="0.0"/></graphicElement>
                </rectangle>
                <textField>
                    <reportElement x="5" y="4" width="220" height="16" forecolor="#FFFFFF"/>
                    <textElement><font fontName="Arial" size="10" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA[$F{full_name}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="225" y="4" width="150" height="16" forecolor="#AED6F1"/>
                    <textElement><font fontName="Arial" size="9"/></textElement>
                    <textFieldExpression><![CDATA["NIC: " + $F{nic}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="375" y="4" width="140" height="16" forecolor="#AED6F1"/>
                    <textElement><font fontName="Arial" size="9"/></textElement>
                    <textFieldExpression><![CDATA["Phone: " + $F{phone}]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true">
                    <reportElement x="515" y="4" width="267" height="16" forecolor="#AED6F1"/>
                    <textElement><font fontName="Arial" size="9"/></textElement>
                    <textFieldExpression><![CDATA[$F{email} != null ? "Email: " + $F{email} : ""]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true">
                    <reportElement x="5" y="20" width="777" height="14" forecolor="#85C1E9"/>
                    <textElement><font fontName="Arial" size="8" isItalic="true"/></textElement>
                    <textFieldExpression><![CDATA[$F{address} != null ? "Address: " + $F{address} : ""]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>

        <!-- Guest footer band — per-guest subtotal -->
        <groupFooter>
            <band height="20">
                <rectangle>
                    <reportElement x="0" y="0" width="782" height="20" backcolor="#D6EAF8"/>
                    <graphicElement><pen lineWidth="0.0"/></graphicElement>
                </rectangle>
                <staticText>
                    <reportElement x="500" y="2" width="180" height="16"/>
                    <textElement textAlignment="Right"><font fontName="Arial" size="9" isBold="true"/></textElement>
                    <text><![CDATA[Total Paid by this Guest (LKR):]]></text>
                </staticText>
                <textField pattern="#,##0.00">
                    <reportElement x="680" y="2" width="102" height="16" forecolor="#1A5276"/>
                    <textElement textAlignment="Right"><font fontName="Arial" size="9" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA[$V{GUEST_TOTAL}]]></textFieldExpression>
                </textField>
                <line><reportElement x="0" y="19" width="782" height="1" forecolor="#85C1E9"/></line>
            </band>
        </groupFooter>
    </group>

    <!-- 5. TITLE -->
    <title>
        <band height="75">
            <rectangle>
                <reportElement x="0" y="0" width="782" height="58" backcolor="#1A5276"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="0" y="6" width="782" height="28" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font fontName="Arial" size="17" isBold="true"/></textElement>
                <text><![CDATA[GRAND VISTA HOTEL — GUEST HISTORY REPORT]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="34" width="782" height="18" forecolor="#AED6F1"/>
                <textElement textAlignment="Center"><font fontName="Arial" size="10"/></textElement>
                <text><![CDATA[Complete Booking History per Guest]]></text>
            </staticText>
            <textField>
                <reportElement x="580" y="62" width="202" height="12"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="8" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA["Generated: " + new java.text.SimpleDateFormat("dd-MMM-yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- 6. COLUMN HEADER -->
    <columnHeader>
        <band height="22">
            <rectangle>
                <reportElement x="0" y="0" width="782" height="22" backcolor="#2C3E50"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <staticText><reportElement x="0"   y="3" width="50"  height="16" forecolor="#FFFFFF"/><textElement><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Bk#]]></text></staticText>
            <staticText><reportElement x="50"  y="3" width="55"  height="16" forecolor="#FFFFFF"/><textElement><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Room]]></text></staticText>
            <staticText><reportElement x="105" y="3" width="70"  height="16" forecolor="#FFFFFF"/><textElement><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Room Type]]></text></staticText>
            <staticText><reportElement x="175" y="3" width="85"  height="16" forecolor="#FFFFFF"/><textElement><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Check-In]]></text></staticText>
            <staticText><reportElement x="260" y="3" width="85"  height="16" forecolor="#FFFFFF"/><textElement><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Check-Out]]></text></staticText>
            <staticText><reportElement x="345" y="3" width="45"  height="16" forecolor="#FFFFFF"/><textElement textAlignment="Center"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Nights]]></text></staticText>
            <staticText><reportElement x="390" y="3" width="90"  height="16" forecolor="#FFFFFF"/><textElement textAlignment="Right"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Rate/Night]]></text></staticText>
            <staticText><reportElement x="480" y="3" width="90"  height="16" forecolor="#FFFFFF"/><textElement textAlignment="Right"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Amt Paid (LKR)]]></text></staticText>
            <staticText><reportElement x="570" y="3" width="80"  height="16" forecolor="#FFFFFF"/><textElement textAlignment="Center"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Method]]></text></staticText>
            <staticText><reportElement x="650" y="3" width="132" height="16" forecolor="#FFFFFF"/><textElement textAlignment="Center"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Status]]></text></staticText>
        </band>
    </columnHeader>

    <!-- 7. DETAIL -->
    <detail>
        <band height="20">
            <rectangle>
                <reportElement x="0" y="0" width="782" height="20" backcolor="#EBF5FB">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <!-- No booking row -->
            <staticText>
                <reportElement x="0" y="2" width="782" height="16" forecolor="#AAB7B8">
                    <printWhenExpression><![CDATA[$F{booking_id} == null]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center"><font fontName="Arial" size="8" isItalic="true"/></textElement>
                <text><![CDATA[— No bookings recorded for this guest —]]></text>
            </staticText>
            <!-- Booking data fields -->
            <textField isBlankWhenNull="true"><reportElement x="0"   y="2" width="50"  height="16"><printWhenExpression><![CDATA[$F{booking_id} != null]]></printWhenExpression></reportElement><textElement><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{booking_id}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="50"  y="2" width="55"  height="16"><printWhenExpression><![CDATA[$F{booking_id} != null]]></printWhenExpression></reportElement><textElement><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{room_number}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="105" y="2" width="70"  height="16"><printWhenExpression><![CDATA[$F{booking_id} != null]]></printWhenExpression></reportElement><textElement><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{room_type}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true" pattern="dd-MMM-yyyy"><reportElement x="175" y="2" width="85" height="16"><printWhenExpression><![CDATA[$F{booking_id} != null]]></printWhenExpression></reportElement><textElement><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{check_in_date}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true" pattern="dd-MMM-yyyy"><reportElement x="260" y="2" width="85" height="16"><printWhenExpression><![CDATA[$F{booking_id} != null]]></printWhenExpression></reportElement><textElement><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{check_out_date}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="345" y="2" width="45"  height="16"><printWhenExpression><![CDATA[$F{booking_id} != null]]></printWhenExpression></reportElement><textElement textAlignment="Center"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{nights}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true" pattern="#,##0.00"><reportElement x="390" y="2" width="90" height="16"><printWhenExpression><![CDATA[$F{booking_id} != null]]></printWhenExpression></reportElement><textElement textAlignment="Right"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{price_per_night}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true" pattern="#,##0.00"><reportElement x="480" y="2" width="90" height="16"><printWhenExpression><![CDATA[$F{booking_id} != null]]></printWhenExpression></reportElement><textElement textAlignment="Right"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{amount_paid}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="570" y="2" width="80"  height="16"><printWhenExpression><![CDATA[$F{booking_id} != null]]></printWhenExpression></reportElement><textElement textAlignment="Center"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{payment_method}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="650" y="2" width="132" height="16"><printWhenExpression><![CDATA[$F{booking_id} != null]]></printWhenExpression></reportElement><textElement textAlignment="Center"><font fontName="Arial" size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{booking_status}]]></textFieldExpression></textField>
            <line><reportElement x="0" y="19" width="782" height="1" forecolor="#D5DBDB"/></line>
        </band>
    </detail>

    <!-- 8. PAGE FOOTER -->
    <pageFooter>
        <band height="18">
            <staticText>
                <reportElement x="0" y="2" width="300" height="12" forecolor="#7F8C8D"/>
                <textElement><font fontName="Arial" size="7"/></textElement>
                <text><![CDATA[Hotel Management System — Guest History Report]]></text>
            </staticText>
            <textField>
                <reportElement x="682" y="2" width="100" height="12"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of " + $V{PAGE_COUNT}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- 9. SUMMARY (must be LAST) -->
    <summary>
        <band height="55">
            <line>
                <reportElement x="0" y="2" width="782" height="2" forecolor="#1A5276"/>
                <graphicElement><pen lineWidth="2.0"/></graphicElement>
            </line>
            <staticText>
                <reportElement x="480" y="12" width="200" height="18"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="13" isBold="true"/></textElement>
                <text><![CDATA[GRAND TOTAL REVENUE (LKR):]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="680" y="12" width="102" height="18" forecolor="#1A5276"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="13" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{GRAND_TOTAL_PAID}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="38" width="782" height="14" forecolor="#7F8C8D"/>
                <textElement textAlignment="Center"><font fontName="Arial" size="8" isItalic="true"/></textElement>
                <text><![CDATA[** This report is system-generated by the Hotel Management System. Confidential. **]]></text>
            </staticText>
        </band>
    </summary>

</jasperReport>
