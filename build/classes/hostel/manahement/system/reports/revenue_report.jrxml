<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="revenue_report"
    pageWidth="842" pageHeight="595" orientation="Landscape"
    columnWidth="782" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">

    <!-- 1. PARAMETERS -->
    <parameter name="START_DATE" class="java.sql.Date"/>
    <parameter name="END_DATE" class="java.sql.Date"/>

    <!-- 2. QUERY -->
    <queryString><![CDATA[
        SELECT b.booking_id, g.full_name AS guest_name, g.phone AS guest_phone,
               r.room_number, r.room_type, r.price_per_night,
               b.check_in_date, b.check_out_date,
               DATEDIFF(b.check_out_date, b.check_in_date) AS nights,
               b.total_amount, p.amount_paid, p.payment_method, p.payment_date
        FROM bookings b
        JOIN guests   g ON b.guest_id   = g.guest_id
        JOIN rooms    r ON b.room_id    = r.room_id
        JOIN payments p ON b.booking_id = p.booking_id
        WHERE b.status = 'Completed'
          AND b.check_out_date BETWEEN $P{START_DATE} AND $P{END_DATE}
        ORDER BY p.payment_date DESC
    ]]></queryString>

    <!-- 3. FIELDS -->
    <field name="booking_id"      class="java.lang.Integer"/>
    <field name="guest_name"      class="java.lang.String"/>
    <field name="guest_phone"     class="java.lang.String"/>
    <field name="room_number"     class="java.lang.String"/>
    <field name="room_type"       class="java.lang.String"/>
    <field name="price_per_night" class="java.lang.Double"/>
    <field name="check_in_date"   class="java.sql.Date"/>
    <field name="check_out_date"  class="java.sql.Date"/>
    <field name="nights"          class="java.lang.Long"/>
    <field name="total_amount"    class="java.lang.Double"/>
    <field name="amount_paid"     class="java.lang.Double"/>
    <field name="payment_method"  class="java.lang.String"/>
    <field name="payment_date"    class="java.lang.String"/>

    <!-- 4. VARIABLES -->
    <variable name="GRAND_TOTAL" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{amount_paid} == null ? 0.0 : $F{amount_paid}]]></variableExpression>
        <initialValueExpression><![CDATA[0.0]]></initialValueExpression>
    </variable>
    <variable name="TOTAL_BOOKINGS" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{booking_id}]]></variableExpression>
    </variable>

    <!-- 5. TITLE -->
    <title>
        <band height="80">
            <rectangle>
                <reportElement x="0" y="0" width="782" height="60" backcolor="#1A5276"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="0" y="5" width="782" height="30" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font fontName="Arial" size="18" isBold="true"/></textElement>
                <text><![CDATA[GRAND VISTA HOTEL — REVENUE REPORT]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="35" width="782" height="20" forecolor="#AED6F1"/>
                <textElement textAlignment="Center"><font fontName="Arial" size="10"/></textElement>
                <text><![CDATA[Completed Bookings with Payment Details]]></text>
            </staticText>
            <textField>
                <reportElement x="580" y="65" width="202" height="14"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="9" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA["Generated: " + new java.text.SimpleDateFormat("dd-MMM-yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- 6. COLUMN HEADER -->
    <columnHeader>
        <band height="26">
            <rectangle>
                <reportElement x="0" y="0" width="782" height="26" backcolor="#2C3E50"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <staticText><reportElement x="0"   y="4" width="35"  height="18" forecolor="#FFFFFF"/><textElement><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Bk#]]></text></staticText>
            <staticText><reportElement x="35"  y="4" width="120" height="18" forecolor="#FFFFFF"/><textElement><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Guest Name]]></text></staticText>
            <staticText><reportElement x="155" y="4" width="80"  height="18" forecolor="#FFFFFF"/><textElement><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Phone]]></text></staticText>
            <staticText><reportElement x="235" y="4" width="55"  height="18" forecolor="#FFFFFF"/><textElement><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Room]]></text></staticText>
            <staticText><reportElement x="290" y="4" width="65"  height="18" forecolor="#FFFFFF"/><textElement><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Type]]></text></staticText>
            <staticText><reportElement x="355" y="4" width="80"  height="18" forecolor="#FFFFFF"/><textElement><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Check-In]]></text></staticText>
            <staticText><reportElement x="435" y="4" width="80"  height="18" forecolor="#FFFFFF"/><textElement><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Check-Out]]></text></staticText>
            <staticText><reportElement x="515" y="4" width="40"  height="18" forecolor="#FFFFFF"/><textElement textAlignment="Center"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Nights]]></text></staticText>
            <staticText><reportElement x="555" y="4" width="80"  height="18" forecolor="#FFFFFF"/><textElement textAlignment="Right"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Amount (LKR)]]></text></staticText>
            <staticText><reportElement x="635" y="4" width="70"  height="18" forecolor="#FFFFFF"/><textElement textAlignment="Center"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Method]]></text></staticText>
            <staticText><reportElement x="705" y="4" width="77"  height="18" forecolor="#FFFFFF"/><textElement textAlignment="Right"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Paid Date]]></text></staticText>
        </band>
    </columnHeader>

    <!-- 7. DETAIL -->
    <detail>
        <band height="22">
            <rectangle>
                <reportElement x="0" y="0" width="782" height="22" backcolor="#EBF5FB">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <textField><reportElement x="0"   y="3" width="35"  height="16"/><textElement><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{booking_id}]]></textFieldExpression></textField>
            <textField><reportElement x="35"  y="3" width="120" height="16"/><textElement><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{guest_name}]]></textFieldExpression></textField>
            <textField><reportElement x="155" y="3" width="80"  height="16"/><textElement><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{guest_phone}]]></textFieldExpression></textField>
            <textField><reportElement x="235" y="3" width="55"  height="16"/><textElement><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{room_number}]]></textFieldExpression></textField>
            <textField><reportElement x="290" y="3" width="65"  height="16"/><textElement><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{room_type}]]></textFieldExpression></textField>
            <textField pattern="dd-MMM-yyyy"><reportElement x="355" y="3" width="80" height="16"/><textElement><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{check_in_date}]]></textFieldExpression></textField>
            <textField pattern="dd-MMM-yyyy"><reportElement x="435" y="3" width="80" height="16"/><textElement><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{check_out_date}]]></textFieldExpression></textField>
            <textField><reportElement x="515" y="3" width="40"  height="16"/><textElement textAlignment="Center"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{nights}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="555" y="3" width="80" height="16"/><textElement textAlignment="Right"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{amount_paid}]]></textFieldExpression></textField>
            <textField><reportElement x="635" y="3" width="70"  height="16"/><textElement textAlignment="Center"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{payment_method}]]></textFieldExpression></textField>
            <textField><reportElement x="705" y="3" width="77"  height="16"/><textElement textAlignment="Right"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{payment_date} != null ? $F{payment_date}.toString().substring(0,10) : ""]]></textFieldExpression></textField>
            <line><reportElement x="0" y="21" width="782" height="1" forecolor="#D5DBDB"/></line>
        </band>
    </detail>

    <!-- 8. PAGE FOOTER -->
    <pageFooter>
        <band height="20">
            <staticText>
                <reportElement x="0" y="2" width="300" height="14" forecolor="#7F8C8D"/>
                <textElement><font fontName="Arial" size="8"/></textElement>
                <text><![CDATA[Hotel Management System — Revenue Report]]></text>
            </staticText>
            <textField>
                <reportElement x="682" y="2" width="100" height="14"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of " + $V{PAGE_COUNT}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- 9. SUMMARY (must come LAST) -->
    <summary>
        <band height="60">
            <line>
                <reportElement x="0" y="2" width="782" height="2" forecolor="#1A5276"/>
                <graphicElement><pen lineWidth="2.0"/></graphicElement>
            </line>
            <staticText>
                <reportElement x="0" y="12" width="200" height="20"/>
                <textElement><font fontName="Arial" size="11" isBold="true"/></textElement>
                <text><![CDATA[Total Completed Bookings:]]></text>
            </staticText>
            <textField>
                <reportElement x="200" y="12" width="80" height="20" forecolor="#1A5276"/>
                <textElement><font fontName="Arial" size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{TOTAL_BOOKINGS}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="480" y="12" width="200" height="20"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="13" isBold="true"/></textElement>
                <text><![CDATA[TOTAL REVENUE (LKR):]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="680" y="12" width="102" height="20" forecolor="#1A5276"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="13" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{GRAND_TOTAL}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="40" width="782" height="16" forecolor="#7F8C8D"/>
                <textElement textAlignment="Center"><font fontName="Arial" size="8" isItalic="true"/></textElement>
                <text><![CDATA[** System-generated by Hotel Management System. Confidential. **]]></text>
            </staticText>
        </band>
    </summary>

</jasperReport>
