<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="occupancy_report"
    pageWidth="595" pageHeight="842"
    columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">

    <!-- 1. QUERY -->
    <queryString><![CDATA[
        SELECT
            r.room_number,
            r.room_type,
            r.status AS room_status,
            r.price_per_night,
            COUNT(b.booking_id) AS total_bookings,
            SUM(DATEDIFF(b.check_out_date, b.check_in_date)) AS total_nights,
            MAX(b.check_out_date) AS last_checkout,
            g.full_name AS last_guest
        FROM rooms r
        LEFT JOIN bookings b ON r.room_id = b.room_id AND b.status = 'Completed'
        LEFT JOIN guests g ON b.guest_id = g.guest_id
            AND b.booking_id = (
                SELECT MAX(b2.booking_id) FROM bookings b2
                WHERE b2.room_id = r.room_id AND b2.status = 'Completed'
            )
        GROUP BY r.room_id, r.room_number, r.room_type, r.status, r.price_per_night, g.full_name
        ORDER BY r.room_number
    ]]></queryString>

    <!-- 2. FIELDS -->
    <field name="room_number"     class="java.lang.String"/>
    <field name="room_type"       class="java.lang.String"/>
    <field name="room_status"     class="java.lang.String"/>
    <field name="price_per_night" class="java.lang.Double"/>
    <field name="total_bookings"  class="java.lang.Long"/>
    <field name="total_nights"    class="java.lang.Long"/>
    <field name="last_checkout"   class="java.sql.Date"/>
    <field name="last_guest"      class="java.lang.String"/>

    <!-- 3. VARIABLES -->
    <variable name="SUM_NIGHTS" class="java.lang.Long" calculation="Sum">
        <variableExpression><![CDATA[$F{total_nights} == null ? 0L : $F{total_nights}]]></variableExpression>
        <initialValueExpression><![CDATA[0L]]></initialValueExpression>
    </variable>
    <variable name="SUM_BOOKINGS" class="java.lang.Long" calculation="Sum">
        <variableExpression><![CDATA[$F{total_bookings} == null ? 0L : $F{total_bookings}]]></variableExpression>
        <initialValueExpression><![CDATA[0L]]></initialValueExpression>
    </variable>

    <!-- 4. TITLE -->
    <title>
        <band height="70">
            <rectangle>
                <reportElement x="0" y="0" width="535" height="55" backcolor="#1A5276"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="0" y="8" width="535" height="28" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font fontName="Arial" size="16" isBold="true"/></textElement>
                <text><![CDATA[GRAND VISTA HOTEL — OCCUPANCY REPORT]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="36" width="535" height="16" forecolor="#AED6F1"/>
                <textElement textAlignment="Center"><font fontName="Arial" size="9"/></textElement>
                <text><![CDATA[Room-by-Room Booking Statistics]]></text>
            </staticText>
            <textField>
                <reportElement x="350" y="58" width="185" height="12"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="8" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA["Generated: " + new java.text.SimpleDateFormat("dd-MMM-yyyy").format(new java.util.Date())]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- 5. COLUMN HEADER -->
    <columnHeader>
        <band height="24">
            <rectangle>
                <reportElement x="0" y="0" width="535" height="24" backcolor="#2C3E50"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <staticText><reportElement x="0"   y="4" width="55"  height="16" forecolor="#FFFFFF"/><textElement><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Room No.]]></text></staticText>
            <staticText><reportElement x="55"  y="4" width="70"  height="16" forecolor="#FFFFFF"/><textElement><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Type]]></text></staticText>
            <staticText><reportElement x="125" y="4" width="70"  height="16" forecolor="#FFFFFF"/><textElement><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Status]]></text></staticText>
            <staticText><reportElement x="195" y="4" width="80"  height="16" forecolor="#FFFFFF"/><textElement textAlignment="Right"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Price/Night]]></text></staticText>
            <staticText><reportElement x="275" y="4" width="55"  height="16" forecolor="#FFFFFF"/><textElement textAlignment="Center"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Bookings]]></text></staticText>
            <staticText><reportElement x="330" y="4" width="55"  height="16" forecolor="#FFFFFF"/><textElement textAlignment="Center"><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Nights]]></text></staticText>
            <staticText><reportElement x="385" y="4" width="150" height="16" forecolor="#FFFFFF"/><textElement><font fontName="Arial" size="8" isBold="true"/></textElement><text><![CDATA[Last Guest]]></text></staticText>
        </band>
    </columnHeader>

    <!-- 6. DETAIL -->
    <detail>
        <band height="22">
            <rectangle>
                <reportElement x="0" y="0" width="535" height="22" backcolor="#EBF5FB">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <textField><reportElement x="0"   y="3" width="55"  height="16"/><textElement><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{room_number}]]></textFieldExpression></textField>
            <textField><reportElement x="55"  y="3" width="70"  height="16"/><textElement><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{room_type}]]></textFieldExpression></textField>
            <textField><reportElement x="125" y="3" width="70"  height="16"/><textElement><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{room_status}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="195" y="3" width="80" height="16"/><textElement textAlignment="Right"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{price_per_night}]]></textFieldExpression></textField>
            <textField><reportElement x="275" y="3" width="55"  height="16"/><textElement textAlignment="Center"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{total_bookings} != null ? $F{total_bookings} : 0L]]></textFieldExpression></textField>
            <textField><reportElement x="330" y="3" width="55"  height="16"/><textElement textAlignment="Center"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{total_nights} != null ? $F{total_nights} : 0L]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="385" y="3" width="150" height="16"/><textElement><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{last_guest} != null ? $F{last_guest} : "—"]]></textFieldExpression></textField>
            <line><reportElement x="0" y="21" width="535" height="1" forecolor="#D5DBDB"/></line>
        </band>
    </detail>

    <!-- 7. PAGE FOOTER -->
    <pageFooter>
        <band height="18">
            <staticText>
                <reportElement x="0" y="2" width="250" height="12" forecolor="#7F8C8D"/>
                <textElement><font fontName="Arial" size="7"/></textElement>
                <text><![CDATA[Hotel Management System — Occupancy Report]]></text>
            </staticText>
            <textField>
                <reportElement x="435" y="2" width="100" height="12"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of " + $V{PAGE_COUNT}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- 8. SUMMARY (must be LAST) -->
    <summary>
        <band height="50">
            <line>
                <reportElement x="0" y="2" width="535" height="2" forecolor="#1A5276"/>
                <graphicElement><pen lineWidth="2.0"/></graphicElement>
            </line>
            <staticText>
                <reportElement x="0" y="12" width="200" height="18"/>
                <textElement><font fontName="Arial" size="10" isBold="true"/></textElement>
                <text><![CDATA[Total Bookings:]]></text>
            </staticText>
            <textField>
                <reportElement x="200" y="12" width="80" height="18" forecolor="#1A5276"/>
                <textElement><font fontName="Arial" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{SUM_BOOKINGS}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="300" y="12" width="120" height="18"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="10" isBold="true"/></textElement>
                <text><![CDATA[Total Nights Sold:]]></text>
            </staticText>
            <textField>
                <reportElement x="420" y="12" width="115" height="18" forecolor="#1A5276"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{SUM_NIGHTS}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="34" width="535" height="12" forecolor="#7F8C8D"/>
                <textElement textAlignment="Center"><font fontName="Arial" size="7" isItalic="true"/></textElement>
                <text><![CDATA[** System Generated — Hotel Management System **]]></text>
            </staticText>
        </band>
    </summary>

</jasperReport>
